{
  "name": "aico-ppt-skill",
  "version": "0.1.30",
  "description": "AICO-PPT Agent Skill 与 DeepSeek Harness 可视化 Editor 插件",
  "private": true,
  "type": "module",
  "main": "integrations/dsh/index.mjs",
  "exports": {
    ".": "./integrations/dsh/index.mjs",
    "./client": "./integrations/dsh/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "SKILL.md",
    "INSTALL.md",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "aico.release.json",
    "references/",
    "assets/",
    "docs/user-guide/",
    "integrations/dsh/",
    "scripts/",
    "!integrations/dsh/tests/**",
    "!scripts/**/__pycache__/**",
    "!scripts/**/*.pyc",
    "!scripts/editor/test/**",
    "!scripts/editor/prototypes/**",
    "!scripts/editor/wsl-*",
    "!scripts/editor/wsl_*",
    "!scripts/editor/agent-terminal-loader.mjs",
    "!scripts/editor/agent-terminal-projection.mjs",
    "!scripts/editor/agent-terminal-runtime.mjs",
    "!scripts/editor/agent-terminal-session.mjs",
    "!scripts/run-editor-tests.mjs",
    "!scripts/test_*.py",
    "!scripts/verify/*.test.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workbench"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test:dsh-plugin": "node --test integrations/dsh/tests/*.test.mjs",
    "test:editor:unit": "node scripts/run-editor-tests.mjs unit",
    "test:editor:e2e": "node scripts/run-editor-tests.mjs e2e",
    "test:editor:python": "node scripts/run-editor-tests.mjs python",
    "test:editor": "node scripts/run-editor-tests.mjs all"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "html2canvas": "1.4.1",
    "playwright-core": "1.62.1",
    "three": "0.185.1",
    "ws": "8.21.1"
  },
  "bundledDependencies": [
    "busboy",
    "html2canvas",
    "playwright-core",
    "three",
    "ws"
  ]
}
